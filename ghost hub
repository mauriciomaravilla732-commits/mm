local function updateSlider(input)[cite: 1]
	local posX = math.clamp(input.Position.X - sliderTrack.AbsolutePosition.X, 0, sliderTrack.AbsoluteSize.X)[cite: 1]
	local percentage = posX / sliderTrack.AbsoluteSize.X[cite: 1]
	
	local steps = math.floor(((percentage * (maxFps - minFps)) + 5) / 10)[cite: 1]
	local currentFps = math.clamp(minFps + (steps * 10), minFps, maxFps)[cite: 1]
	
	local visualPercent = (currentFps - minFps) / (maxFps - minFps)[cite: 1]
	sliderFill.Size = UDim2.new(visualPercent, 0, 1, 0)[cite: 1]
	targetFpsLabel.Text = tostring(currentFps) .. " FPS"[cite: 1]
	
	setFpsCap(currentFps)[cite: 1]
end[cite: 1]

