local function getToolType(tool)[cite: 1]
	if not tool:IsA("Tool") then return nil end[cite: 1]
	local name = tool.Name[cite: 1]
	local tooltip = tool:FindFirstChild("ToolTip") and tool.ToolTip.Value or ""[cite: 1]

	if tooltip == "Melee" or name:find("Combat") or name:find("Dark Step") or name:find("Electric") or name:find("Water") or name:find("Dragon") or name:find("Godhuman") or name:find("Sanguine") then[cite: 1]
		return "Melee", name[cite: 1]
	end

	for _, g in ipairs(gunNames) do[cite: 1]
		if name == g or name:find(g) then return "Gun", name end[cite: 1]
	end
	if tooltip == "Gun" or name:find("Bow") or name:find("Gun") or name:find("Rifle") or name:find("Cannon") or name:find("Slingshot") or name:find("Flintlock") or name:find("Musket") or name:find("Bazooka") or name:find("Guitar") then[cite: 1]
		return "Gun", name[cite: 1]
	end

	for _, f in ipairs(fruitNames) do[cite: 1]
		if (name == f or name:find(f)) and not name:find("Bow") then[cite: 1]
			return "Fruit", name[cite: 1]
		end 
	end
	if tooltip == "Blox Fruit" then return "Fruit", name end[cite: 1]

	if tooltip == "Sword" or name:find("Katana") or name:find("Sword") or name:find("Saber") or name:find("Yoru") or name:find("Dagger") or name:find("Dark Blade") or name:find("Triple Katana") or name:find("Blade") then[cite: 1]
		return "Sword", name[cite: 1]
	end

	return nil[cite: 1]
end

local function updateEquipment()[cite: 1]
	local itemsFound = {Melee="Ninguno", Fruit="Ninguno", Sword="Ninguna", Gun="Ninguna"}[cite: 1]
	local function process(container)[cite: 1]
		if not container then return end[cite: 1]
		for _, tool in pairs(container:GetChildren()) do[cite: 1]
			local cat, n = getToolType(tool)[cite: 1]
			if cat then itemsFound[cat] = n end[cite: 1]
		end
	end
	process(player:FindFirstChild("Backpack"))[cite: 1]
	process(player.Character)[cite: 1]
	
	categoryLabels[1].Text = "1- Melee: " .. itemsFound.Melee[cite: 1]
	categoryLabels[2].Text = "2- Fruta: " .. itemsFound.Fruit[cite: 1]
	categoryLabels[3].Text = "3- Espada: " .. itemsFound.Sword[cite: 1]
	categoryLabels[4].Text = "4- Pistola: " .. itemsFound.Gun[cite: 1]
	
	teamLabel.Text = "Team: " .. (player.Team and player.Team.Name or "Ninguno")[cite: 1]
	
	local bounty = 0[cite: 1]
	pcall(function()[cite: 1]
		if player:FindFirstChild("leaderstats") then[cite: 1]
			local b = player.leaderstats:FindFirstChild("Bounty/Honor") or player.leaderstats:FindFirstChild("Bounty")[cite: 1]
			if b then bounty = b.Value end[cite: 1]
		end
	end)

	if not initialBounty and bounty > 0 then[cite: 1]
		initialBounty = bounty[cite: 1]
	end

	local earned = initialBounty and (bounty - initialBounty) or 0[cite: 1]
	local earnedSign = earned >= 0 and "+$" or "-$"[cite: 1]

	bountyLabel.Text = "Bounty/Honor: " .. formatBounty(bounty)[cite: 1]
	earnedBountyLabel.Text = "Bounty Ganado: " .. earnedSign .. formatBounty(math.abs(earned)):sub(2)[cite: 1]
end

